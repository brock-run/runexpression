{
  "name": "runexpression",
  "version": "1.0.0",
  "private": true,
  "description": "RunExpression - Where runners express themselves through motion, community, and creative flow",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sentry": "next build && npm run sentry:sourcemaps",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "db:types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/database.types.ts",
    "db:push": "npx supabase db push",
    "sync:adrs": "node scripts/sync-adrs-to-skills.js",
    "sync:adrs:dry": "node scripts/sync-adrs-to-skills.js --dry-run",
    "validate:skills": "node scripts/validate-skills-agents.js",
    "sync:skills": "./scripts/convert-skills.sh",
    "generate:guide": "node scripts/generate-ai-agent-guide.js",
    "skills:list": "ls -1 .cursor/skills",
    "agents:list": "ls -1 .cursor/agents",
    "prepare": "husky",
    "sentry:sourcemaps": "node -e \"if(!process.env.SENTRY_ORG||!process.env.SENTRY_PROJECT){console.error('Error: SENTRY_ORG and SENTRY_PROJECT must be set');process.exit(1)}\" && sentry-cli sourcemaps inject --org $SENTRY_ORG --project $SENTRY_PROJECT .next && sentry-cli sourcemaps upload --org $SENTRY_ORG --project $SENTRY_PROJECT .next"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/cli": "^2.58.4",
    "@sentry/react": "^10.36.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.6",
    "@t3-oss/env-nextjs": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.2.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "next-mdx-remote": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-masonry-css": "^1.0.16",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.36.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
